# Core Keeper Dedicated Server Configuration
# Copy this file to .env and customize the values

# ============================================
# WORLD CONFIGURATION
# ============================================

# World slot index (0-4)
# Determines which world save slot to use
WORLD_INDEX=0

# World name displayed in-game
WORLD_NAME=Core Keeper Server

# World generation seed
# Use 0 for random seed, or specify a number for reproducible world generation
WORLD_SEED=0

# Game mode
# 0 = Normal (default)
# 1 = Hard
# 4 = Creative
WORLD_MODE=0

# ============================================
# SERVER CONFIGURATION
# ============================================

# Unique game identifier
# Leave empty to generate automatically
GAME_ID=

# Hashed world seed
# Leave empty to generate automatically
HASHED_WORLD_SEED=
